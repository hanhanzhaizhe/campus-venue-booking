{
  "info": {
    "name": "高校场地预约 P0",
    "description": "先跑「0. 登录」再按序执行 AC。日期变量 tomorrow / nearStart 由集合 Pre-request 按本机时区计算。AC4 请用 scripts/ac4-concurrent.ps1。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function ymd(d) {",
          "  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
          "}",
          "function hm(d) {",
          "  return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');",
          "}",
          "const tomorrow = new Date();",
          "tomorrow.setDate(tomorrow.getDate() + 1);",
          "pm.environment.set('tomorrow', ymd(tomorrow));",
          "const start = new Date();",
          "start.setSeconds(0, 0);",
          "if (start.getMinutes() < 30) { start.setMinutes(30); } else { start.setHours(start.getHours() + 1); start.setMinutes(0); }",
          "if (start.getTime() <= Date.now()) { start.setMinutes(start.getMinutes() + 30); }",
          "const end = new Date(start.getTime() + 30 * 60 * 1000);",
          "pm.environment.set('nearDate', ymd(start));",
          "pm.environment.set('nearStart', hm(start));",
          "pm.environment.set('nearEnd', hm(end));"
        ]
      }
    }
  ],
